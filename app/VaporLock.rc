#define IDI_VAPORLOCK_ICON 101

IDI_VAPORLOCK_ICON ICON "..\\assets\\VaporLock.ico"

// The desktop can read these flags from the image without starting the engine.
// Bit 0 is ONNX Runtime, bit 1 is the CUDA provider API, and bit 2 is PNG preview.
#if defined(VAPORLOCK_HAS_ONNXRUNTIME) && VAPORLOCK_HAS_ONNXRUNTIME && defined(VAPORLOCK_HAS_CUDA) && VAPORLOCK_HAS_CUDA
201 RCDATA { 7 }
#elif defined(VAPORLOCK_HAS_ONNXRUNTIME) && VAPORLOCK_HAS_ONNXRUNTIME
201 RCDATA { 5 }
#else
201 RCDATA { 4 }
#endif
