<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HIDMaestro.VaporLock.Integration</AssemblyName>
    <RootNamespace>HIDMaestro</RootNamespace>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="..\profiles\vapor-lock-xbox-one-windows.json">
      <LogicalName>HIDMaestro.Profiles.vaporlock\vapor-lock-xbox-one-windows.json</LogicalName>
    </EmbeddedResource>
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>..\..\build\controller-host-deps\Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>..\..\build\controller-host-deps\WinRT.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Generated from the pinned original assembly's metadata, never its SDK
       initializer or its upstream PackResources/download/WDK targets. -->
  <Import Project="EmbeddedResources.props" />
</Project>
