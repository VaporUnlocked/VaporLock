// Community project source: https://github.com/VaporUnlocked/VaporLock
#include <windows.h>
#include "@CMAKE_SOURCE_DIR@/source/resource_ids.h"

IDR_SWAT RCDATA "@SUITE_CHARACTER_ASSET@"
IDR_FONT RCDATA "@CMAKE_SOURCE_DIR@/assets/fonts/Interface.ttf"
IDR_LICENSES RCDATA "@CMAKE_SOURCE_DIR@/BUNDLED_LICENSES.txt"
IDR_MODEL_GUIDE RCDATA "@CMAKE_SOURCE_DIR@/MODEL_GUIDE.txt"
IDR_PORTABLE_GUIDE RCDATA "@CMAKE_SOURCE_DIR@/PORTABLE-README.txt"
GLFW_ICON ICON "@CMAKE_SOURCE_DIR@/assets/Suite.ico"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "VaporLock Proving Grounds"
   VALUE "FileVersion", "@PROJECT_VERSION@.0"
   VALUE "InternalName", "VaporLockProvingGrounds"
   VALUE "OriginalFilename", "VaporLock Proving Grounds.exe"
   VALUE "ProductName", "VaporLock Proving Grounds"
   VALUE "ProductVersion", "@PROJECT_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
